{
  "mcpServers": {
    "xray": {
      "command": "python3",
      "args": ["./server/main.py"],
      "cwd": ".",
      "env_vars": [
        "XRAY_CLIENT_ID",
        "XRAY_CLIENT_SECRET",
        "XRAY_REGION",
        "XRAY_SETTINGS_FILE",
        "XRAY_READ_ONLY",
        "XRAY_TOOLS",
        "XRAY_PROJECT_DIR",
        "XRAY_DATA_DIR",
        "JIRA_SITE_URL",
        "JIRA_EMAIL",
        "JIRA_API_TOKEN"
      ]
    }
  }
}
